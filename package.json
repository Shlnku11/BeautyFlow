{
  "name": "next-appointments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["packages/client", "packages/server", "packages/shared"],
  "scripts": {
    "dev": "concurrently -k -n api,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch packages/server/src/index.ts",
    "dev:client": "vite --config packages/client/vite.config.ts --host 0.0.0.0",
    "build": "npm run build --workspace @next-appointments/client && npm run build --workspace @next-appointments/server",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "lint": "eslint packages tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:isolation": "vitest run tests/isolation",
    "test:race": "vitest run tests/race",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/server/scripts/migrate.ts",
    "worker": "node --env-file-if-exists=.env --import tsx packages/server/scripts/worker.ts",
    "check:contrast": "tsx scripts/check-contrast.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-query": "^5.104.1",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.12.31",
    "luxon": "^3.7.2",
    "mongoose": "^9.0.0",
    "nodemailer": "^10.0.14",
    "pino": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.66.1",
    "react-router": "^7.9.5",
    "recharts": "^3.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "mongodb-memory-server": "^10.2.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.2",
    "vitest": "^4.0.15"
  }
}
