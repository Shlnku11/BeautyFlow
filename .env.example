NODE_ENV=development
APP_BASE_URL=http://localhost:3000

MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=nextappointments
MONGODB_MAX_POOL_SIZE=20

SESSION_COOKIE_NAME=na_sid
SESSION_TTL_DAYS=14
SESSION_ABSOLUTE_TTL_DAYS=90
TOKEN_PEPPER=replace-this-development-value-with-at-least-32-characters
CRON_SECRET=replace-this-development-value-with-at-least-32-characters

# Получить в Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=NextAppointments
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

WORKER_POLL_INTERVAL_SECONDS=30
WORKER_BATCH_LIMIT=50
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info
APP_DEFAULT_COUNTRY_CODE=RU

SMS_PROVIDER=
PUSH_PROVIDER=
TEST_MONGODB_URI=
